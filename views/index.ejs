<%- include("includes/header") %>
       
    <div class="mainPageBlock">
        <div class="buttonDiv">
            
            <% if (isEnglish) {%>
            <a href="/set-language/fi" class="mdl-button mdl-button--raised buttons" style="font-size:14px;">In English</a>
            <a href="/contact" class="mdl-button mdl-button--raised" style="font-size:14px;">Ota yhteyttä</a>
            <% } else { %>
            <a href="/set-language/en" class="mdl-button mdl-button--raised buttons"style="font-size:14px;">Suomeksi</a>
            <a href="/contact" class="mdl-button mdl-button--raised" style="font-size:14px;">Contact us</a>
            <% } %>
        </div>
            <div class="firstContent">
                <div class="aboutMe" >
                    <% if (isEnglish) {%>
                        <h3>Tietoa minusta</h3>
                        <p>Minulla on lähes 50 vuoden kokemus eletroniikan korjailusta ja rakentamisesta.
                            Brotherin teollisuus brodeerauskoneita olen korjaillut jo useita vuosia eletroniikka puolelta.
                        <br>
                        <br>
                        Olen myös työskennellyt esimerkiksi asiakkaiden kanssa jotka ovat kotoisin
                        Italiasta, Saksasta ja Hollannista. Testaan korjatut tuotteet huolellisesti,
                        ennenkö lähetän ne eteen päin. 
                        </p>
                        <% } else { %>
                            <h3>About Me</h3> <p>I have nearly 50 years of experience in repairing and building electronics. 
                                I have been repairing Brother industry embroidery machines for several years on the electronics side. 
                                <br> <br> 
                                I have also worked with clients from Italy, Germany, and the Netherlands. 
                                I thoroughly test the repaired products before sending them forward. </p>
                            <% } %>
                </div>
                <img src="/images/tyokalut.png" alt="information about me"/>
            </div>
            <div class="secondContent">
                <div class="devices">
                    <div class="devicesTextContent">
                    <% if (isEnglish) {%>
                     <h3>laitteita, joita korjaillaan</h3>
                    <p>Brother teollisuus brodeerauskoneet</p>
                    <ul>
                        <li>bas-412</li>
                        <li>bas-416</li>
                        <li>bes-1261</li>
                        <li>bes-1216</li>
                        <li>bes-1206, 1204</li>
                        <li>bes-960</li>
                        <li>be-1206</li>
                        <li>be-1204 </li>
                        <li>Sähkösukkuloiden korjaus malleihin: Bas-960 ja Bas-963</li>
                    </ul>
                    <% } else { %>
                        <h3>Devices That Are Repaired</h3> 
                        <p>Brother industry Embroidery Machines</p>
                        <ul>
                            <li>bas-412</li>
                            <li>bas-416</li>
                            <li>bes-1261</li>
                            <li>bes-1216</li>
                            <li>bes-1206, 1204</li>
                            <li>bes-960</li>
                            <li>be-1206</li>
                            <li>be-1204 </li>
                            <li>Repair of electronic shuttles for models: Bas-960 and Bas-963</li>
                        </ul>
                    
                        <% } %>
                        </div>
                </div>
                    <img src="/images/brodeeraus1.png" alt="Brother BES" class="brod1"/>
                    <img src="/images/brodeeraus2.png" alt="Brother BE" class="brod2"/>
            </div>
            <div class="thirdContent">
                <div class="parts">
                    <div class="partsTextContent">
                    <% if (isEnglish) {%>
                        <h4>Olen korjannut huoltopalveluna brotherin teollisuus kirjontakoneen elektroniikkaa</h4>
                    <p>Huoltopalvelua korttien osalta olevia konetyyppien malleja.</p>
                    <div class="table-container">
                    <table border="2" cellpadding="6" cellspacing="0">
                        <tr>
                            <th>Malli</th>
                        </tr>
                        <tr>
                            <th>Bas-416, Bas-412 ( esim. parts No.S34565001)</th>
                        </tr>
                        <tr>
                            <th>BES-1216 ( esim parts No S49770-101)</th>
                        </tr>
                        <tr>
                            <th>Emolevyjen korjausta malleihin BES-960, BES-963, BES-1261</th>
                        </tr>
                        <tr>
                            <th>Edellä mainittuihin malleihin 4 – 6 headed elektronisten sukkula järjestelmien korjaus + huolto</th>
                        </tr>
                        <tr>
                            <th>Viimeisen mallin kirjontakoneen BE-1204 , BE-1206 Powerikortin korjaus palvelu</th>
                        </tr>
                        <tr>
                            <th>BE- 1204, BE-1206 Driver vanhempi malli ( B43N057-3, parts No. S55373 )</th>
                        </tr>
                        <tr>
                            <th>Olen saanut myös uusimman version BE-1204,BE-1206 DRIVER kortin toimimaan ( B43N057-4,parts No. S55373 ) (Tyypillinen näytöllä näkyvä virhe: "I / O-Head Error")</th>
                        </tr>
                        </table>
                        </div>
                        <p>Nämä uusimman version driver kortin muutokset liittyen langankatkaisun parantamiseen voin tehdä myös vanhemman version driver korttiin.</p>
                     <% } else { %>
                        <h4>I have repaired the electronics of Brother industrial embroidery machines as a service</h4>
                    <p>Maintenance service for machine types related to circuit boards.</p>

                    <div class="table-container">
                    <table border="2" cellpadding="6" cellspacing="0">
                        <tr>
                            <th>Model</th>
                        </tr>
                        <tr>
                            <th>Bas-416, Bas-412 (e.g. parts No. S34565001)</th>
                        </tr>
                        <tr>
                            <th>BES-1216 (e.g. parts No. S49770-101)</th>
                        </tr>
                        <tr>
                            <th>Mainboard repairs for models BES-960, BES-963, BES-1261</th>
                        </tr>
                        <tr>
                            <th>Repair + maintenance of 4–6 headed electronic shuttle systems for the above-mentioned models</th>
                        </tr>
                        <tr>
                            <th>Power board repair service for the latest embroidery machine models BE-1204, BE-1206</th>
                        </tr>
                        <tr>
                            <th>BE-1204, BE-1206 Driver older version (B43N057-3, parts No. S55373)</th>
                        </tr>
                        <tr>
                            <th>I have also successfully repaired the newest version of the BE-1204, BE-1206 DRIVER board (B43N057-4, parts No. S55373) (A typical error shown on the display is: “I/O‑Head Error”.)</th>
                        </tr>
                    </table>
                    </div>

                    <p>I can also apply the newest driver board modifications related to improving thread trimming, to the older driver board version.</p>

                    <% } %>
                        </div> 
                </div>
                <img src="/images/sparepart1.png" alt="Brother part" class="sparePart1"/>
                <img src="/images/sparepart2.png" alt="Brother parts" class="sparePart2"/>
            </div>
            <div class="fourthContent">
                <img src="/images/brodeeraus3.png" alt="Brother cards" class="mahcine"/>
                <img src="/images/spareparts3.png" alt="Brother machine" class="sparePart3"/>
            </div>

        <div class="buttonDivBottom">
            <% if (isEnglish) {%>
                <a href="/set-language/fi" class="mdl-button mdl-button--raised buttons" style="font-size:14px;">In English</a>
                <a href="/contact" class="mdl-button mdl-button--raised" style="font-size:14px;">Ota yhteyttä</a>
                <% } else { %>
                <a href="/set-language/en" class="mdl-button mdl-button--raised buttons" style="font-size:14px;">Suomeksi</a>
                <a href="/contact" class="mdl-button mdl-button--raised" style="font-size:14px;" >Contact us</a>
                <% } %>
        </div>
</div>

